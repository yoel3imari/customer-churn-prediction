# =============================================================================
# Custom MLflow image — uses Python 3.12 and MLflow matching app version
# =============================================================================
FROM python:3.12-slim

RUN groupadd --gid 1000 mlflowuser && \
    useradd --uid 1000 --gid mlflowuser --shell /bin/sh --create-home mlflowuser

WORKDIR /mlflow

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /mlflow/artifacts \
    && chown -R mlflowuser:mlflowuser /mlflow

RUN pip install --no-cache-dir "mlflow>=2.20.0,<3.0.0" "psycopg2-binary>=2.9.0"

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5005/health || exit 1

USER mlflowuser

EXPOSE 5005

