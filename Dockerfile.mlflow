# =============================================================================
# Custom MLflow image — uses Python 3.12 and MLflow matching app version
# =============================================================================
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "mlflow>=3.14.0" "psycopg2-binary>=2.9.0"

EXPOSE 5005
